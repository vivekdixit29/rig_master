def create_grp_hierarchy(obj, parent_obj=None):
    cmds.select(obj)
    mel.eval("doGroup 0 1 1;")
    cmds.rename(f"{obj}_offset_grp")
    mel.eval("doGroup 0 1 1;")
    cmds.rename(f"{obj}_conn_grp")
    conn_grp = cmds.ls(sl=True)
    mel.eval("doGroup 0 1 1;")
    cmds.rename(f"{obj}_grp")
    main_grp = cmds.ls(sl=True)
    if parent_obj:
        constraint_node = cmds.pointConstraint(parent_obj, main_grp)
        cmds.delete(constraint_node)
    try:
        cmds.parent(main_grp, w=True)
    except RuntimeError:
        pass
    return cmds.ls(sl=True)[0], cmds.listRelatives(cmds.ls(sl=True)[0], children=True)[0]



def nurb_cricle_ctrl(crv_name, red, green, blue):
    mel.eval("circle -ch on -o on -nr 0 0 1 -r 2 ;")
    cmds.rename(crv_name)
    color_curve(crv_name, red, green, blue)

def color_curve(crv_name, red, green, blue):
    cmds.setAttr(crv_name + ".overrideEnabled", 1)
    cmds.setAttr(crv_name + ".overrideRGBColors", 1)
    cmds.setAttr(crv_name + ".overrideColorRGB", red, green, blue, type="double3")


def sub_ik_ctrl_creation(name, sub_ik_count, main_nurbs, main_ik_count):
    start_ctrl = 1
    sub_ik_ctrl_main_grps, sub_ik_jnt_main_grps = [], []

    duplicate_cmd = "duplicate -rr"
    hexa_curve = """curve -d 1
            -p 1 0 0
            -p 0.5 0.866025 0
            -p -0.5 0.866025 0
            -p -1 0 0
            -p -0.5 -0.866025 0
            -p 0.5 -0.866025 0
            -p 1 0 0;"""

    cmds.select(main_nurbs)
    mel.eval(duplicate_cmd)
    cmds.rename(f"{name}_sub_ik_plane")
    sub_ctrl_surface = cmds.ls(sl=True)[0]

    cmds.delete(sub_ctrl_surface, ch=True)
    cmds.rebuildSurface(main_nurbs, spansU=main_ik_count, sv=1)
    lower_span_u_value = 0
    span_u_value = 1 / main_ik_count
    higher_u_value = span_u_value

    for main_ctrl in range(main_ik_count):
        dist_btw_2_ctrl = (higher_u_value - lower_span_u_value)/(sub_ik_count - 1)
        sub_ik_count_loop = sub_ik_count - 1 if main_ctrl +1 < main_ik_count else sub_ik_count
        for ctrl in range(sub_ik_count_loop):
            sub_span_u_value = round(lower_span_u_value + (dist_btw_2_ctrl * ctrl), 5)
            if sub_span_u_value <= 1.0:
                crv_name = f"{name}_ctrl_{start_ctrl:02d}"
                mel.eval(hexa_curve)
                cmds.rename(crv_name)
                color_curve(crv_name, 0.0, 1.0, 1.0)
                sub_ik_ctrl_main_grp, sub_ik_ctrl_conn_grp = create_grp_hierarchy(crv_name)
                sub_ik_ctrl_conn_grp = f"{sub_ik_ctrl_main_grp}|{sub_ik_ctrl_conn_grp}"
                sub_ik_ctrl_main_grps.append(sub_ik_ctrl_main_grp)
                # orient_node_to_surface(sub_ik_ctrl_main_grp, main_nurbs, sub_span_u_value)

                jt_name = f"{name}_sub_ik_jnt_{start_ctrl:02d}"
                cmds.joint(n=jt_name, radius=.3)
                sub_ik_jnt_main_grp, _ = create_grp_hierarchy(jt_name, crv_name)
                sub_ik_jnt_main_grps.append(sub_ik_jnt_main_grp)
                cmds.parentConstraint(crv_name, jt_name, mo=True)
                start_ctrl = start_ctrl + 1
                create_connection_with_nurbs_plane(sub_ik_ctrl_conn_grp, sub_span_u_value, sub_ctrl_surface)

        lower_span_u_value = higher_u_value
        higher_u_value = higher_u_value + span_u_value

    cmds.select(sub_ik_jnt_main_grps)
    mel.eval("doGroup 0 1 1;")
    cmds.rename(f'{name}_sub_ik_jnt_grp')
    cmds.select()
    cmds.select(sub_ik_ctrl_main_grps)
    mel.eval("doGroup 0 1 1;")
    cmds.rename(f'{name}_sub_ik_ctrl_grp')
    return sub_ctrl_surface


