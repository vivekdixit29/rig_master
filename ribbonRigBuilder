def create_connection_with_nurbs_plane(main_grp, span_u_value, sub_ctrl_surface):
    pt_surface_node = cmds.createNode("pointOnSurfaceInfo")
    four_by_four_matrix_node = cmds.createNode("fourByFourMatrix")
    mult_matrix_node = cmds.createNode("multMatrix")
    decompose_matrix_node = cmds.createNode("decomposeMatrix")

    scene_to_cm_str = cmds.convertUnit("1", toUnit="cm")
    scene_to_cm = float(scene_to_cm_str.replace("cm", ""))

    # creating multiply-divide node to fix difference between scene working uint and default working uint
    unit_md = cmds.createNode("multiplyDivide")
    cmds.setAttr(unit_md + ".operation", 1)
    cmds.setAttr(unit_md + ".input2X", scene_to_cm)
    cmds.setAttr(unit_md + ".input2Y", scene_to_cm)
    cmds.setAttr(unit_md + ".input2Z", scene_to_cm)
    cmds.setAttr(pt_surface_node + ".parameterU", span_u_value)
    cmds.setAttr(pt_surface_node + ".parameterV", 0.5)
    cmds.connectAttr(sub_ctrl_surface + ".worldSpace", pt_surface_node + ".inputSurface", force=True)

    # Normal vectors
    cmds.connectAttr(pt_surface_node + ".normalX", four_by_four_matrix_node + ".in00", force=True)
    cmds.connectAttr(pt_surface_node + ".normalY", four_by_four_matrix_node + ".in01", force=True)
    cmds.connectAttr(pt_surface_node + ".normalZ", four_by_four_matrix_node + ".in02", force=True)

    cmds.connectAttr(pt_surface_node + ".normalizedTangentUX", four_by_four_matrix_node + ".in10", force=True)
    cmds.connectAttr(pt_surface_node + ".normalizedTangentUY", four_by_four_matrix_node + ".in11", force=True)
    cmds.connectAttr(pt_surface_node + ".normalizedTangentUZ", four_by_four_matrix_node + ".in12", force=True)

    cmds.connectAttr(pt_surface_node + ".normalizedTangentVX", four_by_four_matrix_node + ".in20", force=True)
    cmds.connectAttr(pt_surface_node + ".normalizedTangentVY", four_by_four_matrix_node + ".in21", force=True)
    cmds.connectAttr(pt_surface_node + ".normalizedTangentVZ", four_by_four_matrix_node + ".in22", force=True)

    # Position converted from scene units → cm
    cmds.connectAttr(pt_surface_node + ".positionX", unit_md + ".input1X", force=True)
    cmds.connectAttr(pt_surface_node + ".positionY", unit_md + ".input1Y", force=True)
    cmds.connectAttr(pt_surface_node + ".positionZ", unit_md + ".input1Z", force=True)
    cmds.connectAttr(unit_md + ".outputX", four_by_four_matrix_node + ".in30", force=True)
    cmds.connectAttr(unit_md + ".outputY", four_by_four_matrix_node + ".in31", force=True)
    cmds.connectAttr(unit_md + ".outputZ", four_by_four_matrix_node + ".in32", force=True)

    cmds.connectAttr(four_by_four_matrix_node + ".output", mult_matrix_node + ".matrixIn[0]", force=True)
    cmds.connectAttr(main_grp + ".parentInverseMatrix[0]", mult_matrix_node + ".matrixIn[1]", force=True)
    cmds.connectAttr(mult_matrix_node + ".matrixSum", decompose_matrix_node + ".inputMatrix")

    cmds.connectAttr(decompose_matrix_node + ".outputTranslate", main_grp + ".translate")
    cmds.connectAttr(decompose_matrix_node + ".outputRotate", main_grp + ".rotate")


def create_fk_setup(name, joint_count, nurbs_surface):
    cmds.rebuildSurface(nurbs_surface, su=joint_count, sv=1)
    fk_joints = []
    cmds.select(clear=True)
    last_jt_name, last_ctrl_name = None, None
    span_u_multiper = 1 / joint_count
    for jt in range(joint_count + 1):
        jt_name = f"{name}_fk_jnt_{(jt + 1):02d}"
        crv_name = f"{name}_fk_ctrl_{(jt + 1):02d}"
        mel.eval("circle -ch on -o on -nr 0 0 1 -r 2 ;")
        cmds.rename(crv_name)
        color_curve(crv_name, .5, 0.5, 0.5)
        main_grp, _ = create_grp_hierarchy(crv_name)
        span_u_value = span_u_multiper * jt
        follicle_node = create_follicle_system(nurbs_surface, span_u_value)
        constraint_node = cmds.pointConstraint(follicle_node, main_grp)
        cmds.delete(constraint_node)
        cmds.delete(follicle_node)
        if last_ctrl_name:
            cmds.parent(main_grp, last_ctrl_name)
        cmds.joint(n=jt_name, radius=.3)
        main_jt_grp, conn_jt_grp = create_grp_hierarchy(jt_name)
        conn_jt_grp = f"{main_jt_grp}|{conn_jt_grp}"
        if last_jt_name:
            cmds.parent(main_jt_grp, last_jt_name)
        cmds.parentConstraint(crv_name, conn_jt_grp)
        last_jt_name = jt_name
        last_ctrl_name = crv_name
        fk_joints.append(jt_name)

    create_skin(nurbs_surface, fk_joints)


def create_skin(crv_name, jt_names):
    objects = jt_names + [crv_name]
    cmds.skinCluster(
        *objects,
        bindMethod=0,
        weightDistribution=0,
        maximumInfluences=5,
        obeyMaxInfluences=True,
        dropoffRate=4,
        removeUnusedInfluence=True
    )


def wrap_up(name):
    cmds.select("*_jnt_grp")
    mel.eval("doGroup 0 1 1;")
    cmds.rename(f"{name}_jnt_grp")
    cmds.select("*_ctrl_grp")
    mel.eval("doGroup 0 1 1;")
    cmds.rename(f"{name}_ctrl_grp")



def create_master_ctrl(name, loc1, loc2):
    master_ctrl = cmds.curve(
        d=1,
        p=[
            (-0.333333, -0.333333, 0),
            (-0.333333, -1, 0),
            (0.333333, -1, 0),
            (0.333333, -0.333333, 0),
            (1, -0.333333, 0),
            (1, 0.333333, 0),
            (0.333333, 0.333333, 0),
            (0.333333, 1, 0),
            (-0.333333, 1, 0),
            (-0.333333, 0.333333, 0),
            (-1, 0.333333, 0),
            (-1, -0.333333, 0),
            (-0.333333, -0.333333, 0),
        ],
        k=list(range(13)),
        name=f"{name}_master_ctrl"
    )

    mel.eval("doGroup 0 1 1;")
    cmds.rename(f"{name}_master_ctrl_offset_grp")
    mel.eval("doGroup 0 1 1;")
    master_grp_name = f"{name}_master_ctrl_grp"
    cmds.rename(master_grp_name)


    pos = cmds.xform(loc1, q=True, ws=True, t=True)
    cmds.xform(master_grp_name, ws=True, t=pos)

    cmds.delete(cmds.aimConstraint(
        loc2, master_grp_name,
        aimVector=(0, 0, 1),  # curve's +Z will aim at loc2
        upVector=(0, 1, 0),  # curve's +Y is the “up”
        worldUpType="object",
        worldUpObject=loc1
    ))


