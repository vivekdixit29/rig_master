# ribbonRigBuilder
from maya import mel, cmds
import maya.api.OpenMaya as om
import re


def create_plane_between_locators(loc1, loc2, name, joint_count=3):
    """To Create nurbs-plane"""
    width = 0.5
    # Get world positions
    p1 = om.MVector(*cmds.xform(loc1, q=True, ws=True, t=True))
    p2 = om.MVector(*cmds.xform(loc2, q=True, ws=True, t=True))

    # Compute length
    length = (p2 - p1).length()
    spanU = joint_count
    plane = cmds.nurbsPlane(
        w=length,
        lr=width / length,
        axis=[1, 0, 0],
        d=3,
        ch=False,
        u=spanU,
        name=f"{name}_main_ik_plane"
    )[0]

    mid = (p1 + p2) * 0.5
    cmds.xform(plane, ws=True, t=[mid.x, mid.y, mid.z])

    # Aim vector (locator1 → locator2)
    aim = (p2 - p1).normalize()
    up = om.MVector(0, 0, 1)  # world Y axis

    # If aim is vertical, give it a slight offset to avoid zero-length cross
    if abs(aim * up) > 0.999:
        aim = om.MVector(aim.x + 0.0001, aim.y, aim.z).normalize()

    # Side axis
    side = (up ^ aim).normalize()
    # Recompute orthogonal up
    up = (aim ^ side).normalize()

    # Build orientation matrix
    m = om.MMatrix([
        side.x, side.y, side.z, 0,
        up.x, up.y, up.z, 0,
        aim.x, aim.y, aim.z, 0,
        0, 0, 0, 1
    ])

    # Convert to Euler
    euler = om.MTransformationMatrix(m).rotation()

    cmds.xform(plane, ws=True, rotation=[
        om.MAngle(euler.x).asDegrees(),
        om.MAngle(euler.y).asDegrees(),
        om.MAngle(euler.z).asDegrees()
    ])

    nurbs_shape = cmds.listRelatives(plane, ap=False, shapes=True)[0]
    main_ik_bone = main_ik_setup_creation(name, joint_count, nurbs_shape)
    secondary_nurbs_plane = sub_ik_ctrl_creation(name, 3, plane, joint_count)
    create_skin(secondary_nurbs_plane, main_ik_bone)
    create_fk_setup(name, joint_count, plane)
    # create_master_ctrl(name, loc2, loc1)
    # wrap_up(name)
    return plane


def main_ik_setup_creation(name, ik_count, main_nurbs):
    jt_names = []
    main_ik_jnt_grps, main_ctrl_grps = [], []
    span_u_multiplier = 1 / ik_count
    for ctrl in range(ik_count+1):
        crv_name = f"{name}_ik_ctrl_{ctrl + 1:02d}"
        mel.eval("circle -ch on -o on -nr 0 1 0 -r 1.5 ;")
        cmds.rename(crv_name)
        color_curve(crv_name, 1.0, 0.5, 0.0)
        main_ctrl_grp, conn_ctrl_grp = create_grp_hierarchy(crv_name)
        conn_ctrl_grp = f"{main_ctrl_grp}|{conn_ctrl_grp}"
        main_ctrl_grps.append(main_ctrl_grp)

        jt_name = f"{name}_ik_jnt_{ctrl + 1:02d}"
        cmds.joint(n=jt_name, radius=.3)
        main_ik_jnt_grp, _ = create_grp_hierarchy(jt_name, crv_name)
        main_ik_jnt_grps.append(main_ik_jnt_grp)

        cmds.parentConstraint(crv_name, jt_name, mo=True)

        span_u_value = span_u_multiplier * ctrl
        create_connection_with_nurbs_plane(conn_ctrl_grp, span_u_value, main_nurbs)
        jt_names.append(jt_name)

    cmds.select(main_ik_jnt_grps)
    mel.eval("doGroup 0 1 1;")
    cmds.rename(f'{name}_main_ik_jnt_grp')
    cmds.select(main_ctrl_grps)
    mel.eval("doGroup 0 1 1;")
    cmds.rename(f'{name}_main_ik_ctrl_grp')
    return jt_names


def create_joint(nurbs_shape, joint_count, name):
    joint_main_grps = []
    joint_name = []
    ctrl_main_grps = []
    parameter_u_value = 0
    span_u = 1 / (joint_count - 1)
    for jnt in range(joint_count):
        follicle_node, follicle_shape = create_follicle_system(nurbs_shape, parameter_u_value)
        parameter_u_value += span_u
        jt_name = f"{name}_ik_jnt_{jnt + 1:02d}"
        cmds.joint(n=jt_name, radius=.5)
        main_grp, _ = create_grp_hierarchy(jt_name, follicle_shape)
        joint_main_grps.append(main_grp)
        ctrl_main_grps.append(nurb_cricle_ctrl(jt_name, 1.0, 0.0, .5))
        cmds.delete(follicle_node)
        joint_name.append(jt_name)

    cmds.select(joint_main_grps)
    mel.eval("doGroup 0 1 1;")
    cmds.select(ctrl_main_grps)
    mel.eval("doGroup 0 1 1;")
    return joint_name


def create_follicle_system(nurbs_shape, parameter_u_value):
    follicle_shape = cmds.createNode("follicle", n="follicle")
    follicle_node = cmds.listRelatives(follicle_shape, ap=True, shapes=False)[0]
    cmds.connectAttr(f"{nurbs_shape}.worldMatrix", f"{follicle_shape}.inputWorldMatrix")
    cmds.connectAttr(f"{nurbs_shape}.local", f"{follicle_shape}.inputSurface")
    cmds.connectAttr(f"{follicle_shape}.outRotate", f"{follicle_node}.rotate", force=True)
    cmds.connectAttr(f"{follicle_shape}.outTranslate", f"{follicle_node}.translate", force=True)
    cmds.setAttr(f"{follicle_node}.parameterU", parameter_u_value)
    cmds.setAttr(f"{follicle_node}.parameterV", 0.5)
    return follicle_node, follicle_shape


